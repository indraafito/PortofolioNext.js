{
    "files":  [

              ],
    "references":  [
                       {
                           "path":  "./tsconfig.app.json"
                       },
                       {
                           "path":  "./tsconfig.node.json"
                       }
                   ],
    "compilerOptions":  {
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      },
                            "noImplicitAny":  true,
                            "noUnusedParameters":  true,
                            "skipLibCheck":  true,
                            "allowJs":  true,
                            "noUnusedLocals":  true,
                            "strictNullChecks":  true,
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "strict":  true,
                            "noEmit":  true,
                            "incremental":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "node",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ]
                        },
    "include":  [
                    "next-env.d.ts",
                    ".next/types/**/*.ts",
                    "**/*.ts",
                    "**/*.tsx"
, "scripts/setup-db.js"                ],
    "exclude":  [
                    "node_modules"
                ]
}
